replicaCount: 1
image:
  repository: {{ .Slug }}
  tag: latest
  pullPolicy: Never
service:
  port: 8080
ingress:
  enabled: true
  host: {{ .Slug }}.local
resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    cpu: 500m
    memory: 256Mi
probes:
  livenessPath: /health
  readinessPath: /health
dependencies:
  postgres:
    enabled: false
    host: ""
    port: 5432
    database: ""
    secretName: ""
    usernameKey: username
    passwordKey: password
  redis:
    enabled: false
    host: ""
    port: 6379
    secretName: ""
    passwordKey: password