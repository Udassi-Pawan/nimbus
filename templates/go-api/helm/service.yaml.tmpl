apiVersion: v1
kind: Service
metadata:
  name: {{ .Slug }}
  labels:
    app.kubernetes.io/name: {{ .Slug }}
    nimbus.io/managed-by: nimbus
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: {{ .Slug }}
  ports:
    - name: http
      port: {{ "{{ .Values.service.port }}" }}
      targetPort: 8080
