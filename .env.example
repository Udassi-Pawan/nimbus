# Copy this file to .env in the repo root — the API loads it automatically on startup.
#   copy .env.example .env
#
# Nimbus API
NIMBUS_PORT=8080
NIMBUS_LOG_LEVEL=info

# Database
DATABASE_URL=postgres://nimbus:nimbus@localhost:5432/nimbus?sslmode=disable

# Auth (dev only — change in production)
JWT_SECRET=dev-secret-change-me
NIMBUS_GENERATED_DIR=generated
# Optional: override if auto-detect from go.mod fails
# NIMBUS_REPO_ROOT=
# Optional: templates root (default: templates/)
# NIMBUS_TEMPLATES_DIR=templates

# Kubernetes (Iteration 5) — same kubeconfig as kubectl
# KUBECONFIG=
KUBERNETES_CONTEXT=k3d-nimbus